{
  "$name": "helios-dark",
  "$description": "Helios's own dark theme: neutral greys, the logo's sun gold as accent.",
  "palette": {
    "$type": "color",
    "grey-10": { "$value": "#141414" },
    "grey-12": { "$value": "#1b1b1b" },
    "grey-14": { "$value": "#202020" },
    "grey-16": { "$value": "#242424" },
    "grey-20": { "$value": "#2c2c2c" },
    "grey-24": { "$value": "#363636" },
    "grey-30": { "$value": "#444444" },
    "grey-55": { "$value": "#8f8a80" },
    "grey-85": { "$value": "#e6e3dc" },
    "grey-95": { "$value": "#f6f3ec" },
    "gold": { "$value": "#f0c060" },
    "red": { "$value": "#e0664f" },
    "amber": { "$value": "#e0a040" },
    "green": { "$value": "#7fb27a" },
    "blue": { "$value": "#7aa2d6" }
  },
  "bg": {
    "$type": "color",
    "canvas": { "$value": "{palette.grey-10}" },
    "panel": { "$value": "{palette.grey-12}" },
    "window": { "$value": "{palette.grey-16}" },
    "extreme": { "$value": "{palette.grey-10}" },
    "widget": { "$value": "{palette.grey-20}" },
    "widget_hover": { "$value": "{palette.grey-24}" },
    "widget_active": { "$value": "{palette.grey-30}" }
  },
  "fg": {
    "$type": "color",
    "text": { "$value": "{palette.grey-85}" },
    "weak": { "$value": "{palette.grey-55}" },
    "strong": { "$value": "{palette.grey-95}" }
  },
  "border": { "$type": "color", "$value": "{palette.grey-20}" },
  "accent": {
    "$type": "color",
    "base": { "$value": "{palette.gold}" },
    "text": { "$value": "{palette.grey-10}" }
  },
  "selection": { "$type": "color", "$value": "#f0c06055" },
  "danger": { "$type": "color", "$value": "{palette.red}" },
  "warning": { "$type": "color", "$value": "{palette.amber}" },
  "state": {
    "$type": "color",
    "done": { "$value": "{palette.green}" },
    "running": { "$value": "{palette.blue}" },
    "stale": { "$value": "{palette.grey-55}" },
    "failed": { "$value": "{palette.red}" },
    "pending": { "$value": "{palette.gold}" }
  },
  "radius": {
    "$type": "dimension",
    "widget": { "$value": "4px" },
    "window": { "$value": "8px" }
  },
  "space": { "item": { "$type": "dimension", "$value": "6px" } },
  "font": {
    "size": { "$type": "dimension", "$value": "13px" },
    "ui": { "$type": "fontFamily", "$value": ["Ubuntu", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Hack", "monospace"] }
  }
}
