{
  "$extends": "pop-dark",
  "$description": "Helios's dark theme, the default: Rerun's dark look (near-black neutral greys, its blue as accent) over egui-pop's dark theme, and Helios's own tokens. Its colours, radii and sizes are the Rerun viewer's, from the design tokens of its re_ui crate (MIT OR Apache-2.0, Copyright (c) Rerun Technologies AB), as egui-pop's Rerun-like kit carries them; token values only, not affiliated with or endorsed by Rerun.",
  "$extensions": {
    "org.egui-pop.source": {"repository": "https://github.com/rerun-io/rerun", "file": "crates/ui_tools/re_ui/data/dark_theme.ron, color_table.ron; src/design_tokens.rs", "commit": "7b47acca058797138e5247cd98728557eeeb5107", "license": "MIT OR Apache-2.0", "note": "Rerun's 0 to 1000 grey scale mapped onto egui-pop's 0 to 12 steps; the muted text moved from Gray.375 to Gray.600 for contrast (Rerun's own tab text)."}
  },
  "text": {
    "$type": "color",
    "on-accent": {"$value": "{blue.contrast}"}
  },
  "accent": {
    "$type": "color",
    "default": {"$value": "{blue.9}"},
    "hover": {"$value": "{blue.10}"},
    "active": {"$value": "{blue.8}"},
    "subtle": {"$value": "{blue.3}"}
  },
  "danger": {"$type": "color", "$value": "{red.11}"},
  "success": {"$type": "color", "$value": "{green.11}"},
  "info": {"$type": "color", "$value": "{blue.11}"},
  "radius": {
    "$type": "dimension",
    "widget": {"$value": {"value": 4, "unit": "px"}, "$description": "small_corner_radius"},
    "window": {"$value": {"value": 10, "unit": "px"}, "$description": "window_corner_radius"}
  },
  "size": {
    "$type": "dimension",
    "control": {
      "height": {"$value": {"value": 22, "unit": "px"}, "$description": "large_button_size; also the rows' height here"}
    },
    "icon": {
      "inline": {"$value": {"value": 14, "unit": "px"}, "$description": "small_icon_size"},
      "toolbar": {"$value": {"value": 16, "unit": "px"}}
    },
    "title-bar": {
      "height": {"$value": {"value": 24, "unit": "px"}, "$description": "title_bar_height"}
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "xs": {"$value": {"value": 10.5, "unit": "px"}, "$description": "Typography Small"},
      "s": {"$value": {"value": 11, "unit": "px"}, "$description": "Typography Eyebrow"},
      "m": {"$value": {"value": 12.5, "unit": "px"}, "$description": "Typography Body"},
      "l": {"$value": {"value": 13, "unit": "px"}, "$description": "Typography Heading 4"},
      "xl": {"$value": {"value": 16, "unit": "px"}, "$description": "Typography Heading 3"}
    },
    "text-style": {
      "$type": "dimension",
      "monospace": {"$value": "{font.size.m}", "$description": "Rerun's monospace is the body size."}
    }
  },
  "tab-bar": {
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}", "$description": "tab_bar_color"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}}
    }
  },
  "section-band": {
    "height": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}", "$description": "section_header_color"},
      "text": {"$type": "color", "$value": "{text.strong}"}
    }
  },
  "plot": {
    "shape": {"$type": "string", "$value": "plain", "$description": "No frame: Rerun's plots fill their view."},
    "grid-color": {"$type": "color", "$value": "{gray.4}", "$description": "plot_grid_color: Gray.200 in dark, Gray.850 in light, step 4 of either scale"},
    "grid-fade": {"$type": "number", "$value": 0.3, "$description": "plot_grid_fade"},
    "rest": {
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "radius": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "fill": {"$type": "color", "$value": "{gray.2}", "$description": "Gray.100: viewport_background, a plot background's default"}
    }
  },
  "plot-cursor": {
    "width": {"$type": "dimension", "$value": {"value": 1.5, "unit": "px"}, "$description": "1.5 times the widgets' stroke, as re_ui's paint_time_cursor draws it"},
    "head": {"$type": "string", "$value": "triangle", "$description": "paint_time_cursor's triangle at the top"},
    "head-size": {"$type": "dimension", "$value": {"value": 10, "unit": "px"}, "$description": "The triangle's width"},
    "rest": {
      "fill": {"$type": "color", "$value": "{text.default}", "$description": "The widgets' foreground stroke: text_default"}
    },
    "hover": {
      "fill": {"$type": "color", "$value": "{text.strong}", "$description": "Under the pointer or dragged: the strong text"}
    }
  },
  "graph": {
    "wire-hover": {
      "color": {"$type": "color", "$value": "{text.strong}", "$description": "Rerun highlights what is hovered toward the strong text"},
      "width": {"$type": "dimension", "$value": {"value": 3, "unit": "px"}}
    },
    "wire-selected": {
      "color": {"$type": "color", "$value": "{blue.9}", "$description": "The selection's blue"},
      "width": {"$type": "dimension", "$value": {"value": 3, "unit": "px"}},
      "glow": {"$type": "color", "$value": "{blue.9}"},
      "glow-width": {"$type": "dimension", "$value": {"value": 10, "unit": "px"}},
      "glow-opacity": {"$type": "number", "$value": 0.3}
    }
  },
  "table-header-cell": {
    "shape": {"$type": "string", "$value": "plain", "$description": "A fill and a line under it."},
    "indicator-side": {"$type": "string", "$value": "bottom"},
    "rest": {
      "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
      "fill": {"$type": "color", "$value": "{gray.3}", "$description": "Gray.150: table_header_bg_fill"},
      "border-color": {"$type": "color", "$value": "#2c2b2b", "$description": "Gray.300: table_header_stroke_color"}
    }
  },
  "gray": {
    "$type": "color",
    "$description": "Rerun's neutral greys (Gray.0 to Gray.1000), step by step.",
    "0": {"$value": "#000000", "$description": "Gray.0: extreme_bg_color"},
    "1": {"$value": "#080808", "$description": "Gray.50"},
    "2": {"$value": "#0d0d0d", "$description": "Gray.100: panel_bg_color, top_bar_color, viewport_background"},
    "3": {"$value": "#171717", "$description": "Gray.150: faint_bg_color, list_item_hovered_bg, card_fill"},
    "4": {"$value": "#212121", "$description": "Gray.200: plot_grid_color, notification_background_color"},
    "5": {"$value": "#272626", "$description": "Gray.250: widget_hovered_color"},
    "6": {"$value": "#353434", "$description": "divider_stroke"},
    "7": {"$value": "#454545", "$description": "Gray.350: control_fill"},
    "8": {"$value": "#646363", "$description": "Gray.400: text_readonly"},
    "9": {"$value": "#827f7f", "$description": "Gray.500: list_item_default_icon"},
    "10": {"$value": "#9f9f9f", "$description": "Gray.600: the tab's text"},
    "11": {"$value": "#cccccc", "$description": "Gray.725: text_default"},
    "12": {"$value": "#ffffff", "$description": "Gray.1000: text_strong"}
  },
  "blue": {
    "$type": "color",
    "$description": "Rerun's Blue scale; step 9 is selection_bg_fill (Blue.500).",
    "1": {"$value": "#00051c", "$description": "Blue.50"},
    "2": {"$value": "#000c30", "$description": "Blue.100"},
    "3": {"$value": "#001b53", "$description": "Blue.200"},
    "4": {"$value": "#003084", "$description": "Blue.300"},
    "5": {"$value": "#003da1", "$description": "Blue.350"},
    "6": {"$value": "#004bc2", "$description": "Blue.400: focus_outline_stroke"},
    "7": {"$value": "#005ae6", "$description": "Blue.450"},
    "8": {"$value": "#4676ff", "$description": "Blue.525"},
    "9": {"$value": "#5a81ff", "$description": "Blue.550: Rerun's accent (Blue.500, #186add) one step lighter, so that it reads as text on the panel and carries dark text"},
    "10": {"$value": "#6b8bff", "$description": "Blue.575"},
    "11": {"$value": "#adbbff", "$description": "Blue.700: info_text_color"},
    "12": {"$value": "#f0f2ff", "$description": "Blue.900: text_color_on_primary"},
    "contrast": {"$value": "{gray.0}", "$description": "Text on step 9."}
  },
  "green": {
    "$type": "color",
    "$description": "Rerun's Green scale; step 11 is success_text_color (Green.700).",
    "1": {"$value": "#000803"},
    "2": {"$value": "#001306"},
    "3": {"$value": "#002611"},
    "4": {"$value": "#004021"},
    "5": {"$value": "#00502b"},
    "6": {"$value": "#006236"},
    "7": {"$value": "#007541"},
    "8": {"$value": "#007f47"},
    "9": {"$value": "#00894d"},
    "10": {"$value": "#009353"},
    "11": {"$value": "#00da7e"},
    "12": {"$value": "#caffdc"},
    "contrast": {"$value": "{gray.0}"}
  },
  "red": {
    "$type": "color",
    "$description": "Rerun's Red scale (alert_error uses Red.500).",
    "1": {"$value": "#170003"},
    "2": {"$value": "#290007"},
    "3": {"$value": "#480012"},
    "4": {"$value": "#730022"},
    "5": {"$value": "#8e002c"},
    "6": {"$value": "#ab0037"},
    "7": {"$value": "#cb0043"},
    "8": {"$value": "#db0049"},
    "9": {"$value": "#ec004f"},
    "10": {"$value": "#fd0056"},
    "11": {"$value": "#ff6981"},
    "12": {"$value": "#ffeff0"},
    "contrast": {"$value": "{gray.12}"}
  },
  "surface": {
    "$type": "color",
    "canvas": {"$value": "{gray.2}"},
    "panel": {"$value": "{gray.2}"},
    "raised": {"$value": "{gray.3}"},
    "hover": {"$value": "{gray.5}"},
    "active": {"$value": "{gray.6}"},
    "overlay": {"$value": "{gray.3}"},
    "sunken": {"$value": "{gray.0}"}
  },
  "border": {
    "$type": "color",
    "default": {"$value": "{gray.6}"},
    "strong": {"$value": "{gray.9}"}
  },
  "selection": {"$type": "color", "$value": "{blue.5}", "$description": "Blue.350: a selection under ordinary text; selected rows take Rerun's selection_bg_fill (list-row)."},
  "warning": {"$type": "color", "$value": "#ff7a0c", "$description": "warn_fg_color"},
  "focus": {
    "$type": "color",
    "ring": {"$value": "{blue.9}", "$description": "Rerun's focus_outline_stroke (Blue.400) is too dark on the panel"}
  },
  "button": {
    "rest": {
      "fill": {"$type": "color", "$value": "{gray.5}", "$description": "button_secondary.fill (Gray.300 in Rerun)"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}}
    },
    "hover": {
      "fill": {"$type": "color", "$value": "{gray.4}"}
    },
    "danger": {
      "$type": "color",
      "$description": "Helios component tokens: the primary button of a destructive dialog.",
      "background": {"$value": "{red.8}", "$description": "Red.475: Rerun's Red.500 carries white text at 4.49:1 only, a step darker reads at 5.1:1."},
      "text": {"$value": "{red.contrast}"}
    }
  },
  "tab": {
    "padding-x": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "text": {"$type": "color", "$value": "{gray.10}", "$description": "tab.text (Gray.600)"}
    },
    "hover": {
      "text": {"$type": "color", "$value": "#bfbfbf", "$description": "tab.text_hovered (Gray.700)"}
    },
    "selected": {
      "fill": {"$type": "color", "$value": "{surface.panel}"},
      "text": {"$type": "color", "$value": "#e0dfdf", "$description": "tab.text_selected (Gray.800)"}
    }
  },
  "list-row": {
    "rest": {
      "text": {"$type": "color", "$value": "{text.default}"}
    },
    "hover": {
      "fill": {"$type": "color", "$value": "{gray.3}", "$description": "list_item_hovered_bg"}
    },
    "selected": {
      "fill": {"$type": "color", "$value": "#186add", "$description": "selection_bg_fill (Blue.500)"},
      "text": {"$type": "color", "$value": "{gray.12}"}
    }
  },
  "chart": {
    "$type": "color",
    "$description": "The categorical palette's hues (palette.category aliases them, in order), egui-pop's own hue per slot with its lightness fitted to Rerun's dark surfaces: 3:1 on them, and apart as contrast::check_category asks.",
    "blue": {"$value": "#18b1ff"},
    "orange": {"$value": "#e88405"},
    "green": {"$value": "#09c88a"},
    "pink": {"$value": "#b246a6"},
    "olive": {"$value": "#787604"},
    "periwinkle": {"$value": "#bec3ff"},
    "lime": {"$value": "#afe658"},
    "red": {"$value": "#e04f60"},
    "teal": {"$value": "#02929a"},
    "purple": {"$value": "#ae8afe"}
  },
  "palette": {
    "log": {
      "$type": "color",
      "$description": "The text log's levels, as Rerun's dark theme colours them.",
      "trace": {"$value": "#bfbfbf", "$description": "Gray.700: trace_log_text_color"},
      "debug": {"$value": "#adbbff", "$description": "Blue.700: debug_log_text_color"},
      "info": {"$value": "#00da7e", "$description": "Green.700: info_log_text_color"},
      "warn": {"$value": "{warning}", "$description": "warn_fg_color (#FF7A0C)"},
      "error": {"$value": "{danger}", "$description": "error_fg_color (#AB0116) lifted as `danger` is: Rerun's red does not read on the dark panel"},
      "critical": {"$value": "{red.12}", "$description": "Red.900: Rerun draws critical in strong_fg_color (Gray.1000) on error_fg_color; as a text colour, the red nearest the strong text"}
    }
  },
  "viewport": {
    "background": {"$type": "color", "$value": "{viewport.surround}", "$description": "egui-pop's viewport: around the image, the surround."},
    "surround": {"$type": "color", "$value": "{gray.2}", "$description": "Helios component token: behind the photo being edited. Rerun's viewport background (Gray.100), a neutral near black, the panels' own."},
    "backdrop": {"$type": "color", "$value": "{viewport.surround}", "$description": "egui-pop's viewport: under the image until its tiles arrive, the surround too."}
  },
  "state": {
    "$type": "color",
    "$description": "Helios component tokens: the state of a node in the graph.",
    "done": {"$value": "{success}", "$description": "A node computed and current."},
    "running": {"$value": "{info}", "$description": "A node being computed."},
    "stale": {"$value": "{text.muted}", "$description": "A node whose content is out of date."},
    "failed": {"$value": "{danger}", "$description": "A node whose computation failed."},
    "pending": {"$value": "{accent.default}", "$description": "A decision waiting for an answer."}
  },
  "mask": {
    "overlay": {
      "$description": "Helios component tokens: a mask shown over the image (the mask display's overlay).",
      "color": {"$type": "color", "$value": "{accent.default}", "$description": "Laid over the image where the mask applies, by the mask's value: Rerun's blue, which reads on the greyed image."},
      "opacity": {"$type": "number", "$value": 0.6, "$description": "How much of the colour where the mask is full (0 to 1)."},
      "desaturate": {"$type": "number", "$value": 1.0, "$description": "How far the image under the overlay turns grey (0 its colours, 1 grey, as darktable shows it), so the colour reads on any photo."}
    }
  }
}
