{
  "$extends": "pop-light",
  "$description": "Helios's light theme: Rerun's light look (white paper, its blue as accent) over egui-pop's light theme, a neutral mid-grey surround to judge photos on, and Helios's own tokens. Its colours, radii and sizes are the Rerun viewer's, from the design tokens of its re_ui crate (MIT OR Apache-2.0, Copyright (c) Rerun Technologies AB), as egui-pop's Rerun-like kit carries them; token values only, not affiliated with or endorsed by Rerun.",
  "$extensions": {
    "org.egui-pop.variant-of": "helios-dark",
    "org.egui-pop.source": {"repository": "https://github.com/rerun-io/rerun", "file": "crates/ui_tools/re_ui/data/light_theme.ron, color_table.ron; src/design_tokens.rs", "commit": "7b47acca058797138e5247cd98728557eeeb5107", "license": "MIT OR Apache-2.0", "note": "Rerun's grey scale runs the other way in its light theme: Gray.1000 is the paper, Gray.0 the ink."}
  },
  "text": {
    "$type": "color",
    "on-accent": {"$value": "{blue.contrast}"}
  },
  "accent": {
    "$type": "color",
    "default": {"$value": "{blue.9}"},
    "hover": {"$value": "{blue.10}"},
    "active": {"$value": "{blue.8}"},
    "subtle": {"$value": "{blue.3}"}
  },
  "danger": {"$type": "color", "$value": "{red.11}"},
  "success": {"$type": "color", "$value": "{green.11}"},
  "info": {"$type": "color", "$value": "{blue.11}"},
  "radius": {
    "$type": "dimension",
    "widget": {"$value": {"value": 4, "unit": "px"}, "$description": "small_corner_radius"},
    "window": {"$value": {"value": 10, "unit": "px"}, "$description": "window_corner_radius"}
  },
  "size": {
    "$type": "dimension",
    "control": {
      "height": {"$value": {"value": 22, "unit": "px"}, "$description": "large_button_size; also the rows' height here"}
    },
    "icon": {
      "inline": {"$value": {"value": 14, "unit": "px"}, "$description": "small_icon_size"},
      "toolbar": {"$value": {"value": 16, "unit": "px"}}
    },
    "title-bar": {
      "height": {"$value": {"value": 24, "unit": "px"}, "$description": "title_bar_height"}
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "xs": {"$value": {"value": 10.5, "unit": "px"}, "$description": "Typography Small"},
      "s": {"$value": {"value": 11, "unit": "px"}, "$description": "Typography Eyebrow"},
      "m": {"$value": {"value": 12.5, "unit": "px"}, "$description": "Typography Body"},
      "l": {"$value": {"value": 13, "unit": "px"}, "$description": "Typography Heading 4"},
      "xl": {"$value": {"value": 16, "unit": "px"}, "$description": "Typography Heading 3"}
    },
    "text-style": {
      "$type": "dimension",
      "monospace": {"$value": "{font.size.m}", "$description": "Rerun's monospace is the body size."}
    }
  },
  "tab-bar": {
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}", "$description": "tab_bar_color"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}}
    }
  },
  "section-band": {
    "height": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}", "$description": "section_header_color"},
      "text": {"$type": "color", "$value": "{text.strong}"}
    }
  },
  "plot": {
    "shape": {"$type": "string", "$value": "plain", "$description": "No frame: Rerun's plots fill their view."},
    "rest": {
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "radius": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "fill": {"$type": "color", "$value": "{gray.0}", "$description": "Gray.1000: viewport_background, a plot background's default"}
    }
  },
  "plot-cursor": {
    "width": {"$type": "dimension", "$value": {"value": 1.5, "unit": "px"}, "$description": "1.5 times the widgets' stroke, as re_ui's paint_time_cursor draws it"},
    "rest": {
      "fill": {"$type": "color", "$value": "{text.default}", "$description": "The widgets' foreground stroke: text_default"}
    }
  },
  "table-header-cell": {
    "shape": {"$type": "string", "$value": "plain", "$description": "A fill and a line under it."},
    "indicator-side": {"$type": "string", "$value": "bottom"},
    "rest": {
      "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
      "fill": {"$type": "color", "$value": "{gray.4}", "$description": "Gray.850: table_header_bg_fill"},
      "border-color": {"$type": "color", "$value": "{gray.6}", "$description": "Gray.700: table_header_stroke_color"}
    }
  },
  "gray": {
    "$type": "color",
    "$description": "Rerun's neutral greys, white paper first.",
    "0": {"$value": "#ffffff", "$description": "Gray.1000: panel_bg_color, top_bar_color, viewport_background"},
    "1": {"$value": "#fafafa", "$description": "Gray.975"},
    "2": {"$value": "#f5f5f5", "$description": "Gray.950: list_item_hovered_bg"},
    "3": {"$value": "#eeeeed", "$description": "Gray.900: faint_bg_color"},
    "4": {"$value": "#e6e6e5", "$description": "Gray.850: widget_hovered_color"},
    "5": {"$value": "#e0dfdf", "$description": "Gray.800"},
    "6": {"$value": "#bfbfbf", "$description": "Gray.700: divider_stroke"},
    "7": {"$value": "#adadad", "$description": "Gray.650"},
    "8": {"$value": "#939090", "$description": "Gray.550"},
    "9": {"$value": "#737070", "$description": "Gray.450"},
    "10": {"$value": "#555555", "$description": "Gray.375"},
    "11": {"$value": "#272626", "$description": "Gray.250: text_default"},
    "12": {"$value": "#000000", "$description": "Gray.0: text_strong"}
  },
  "blue": {
    "$type": "color",
    "$description": "Rerun's Blue scale, light side first; step 9 is selection_bg_fill (Blue.500).",
    "1": {"$value": "#fcfdff", "$description": "Blue.975"},
    "2": {"$value": "#f9faff", "$description": "Blue.950"},
    "3": {"$value": "#f0f2ff", "$description": "Blue.900"},
    "4": {"$value": "#e4e7ff", "$description": "Blue.850"},
    "5": {"$value": "#d4dbff", "$description": "Blue.800"},
    "6": {"$value": "#c2ccff", "$description": "Blue.750"},
    "7": {"$value": "#96a8ff", "$description": "Blue.650"},
    "8": {"$value": "#005ae6", "$description": "Blue.450"},
    "9": {"$value": "#186add", "$description": "Blue.500: selection_bg_fill"},
    "10": {"$value": "#0062f9", "$description": "Blue.475 (Rerun's hover, Blue.525, is too light under white text)"},
    "11": {"$value": "#003084", "$description": "Blue.300: info_text_color"},
    "12": {"$value": "#000c30", "$description": "Blue.100"},
    "contrast": {"$value": "#ffffff"}
  },
  "green": {
    "$type": "color",
    "$description": "Rerun's Green scale, light side first; step 11 is success_text_color (Green.300).",
    "1": {"$value": "#f7fff9"},
    "2": {"$value": "#ebfff1"},
    "3": {"$value": "#caffdc"},
    "4": {"$value": "#b2ffcd"},
    "5": {"$value": "#91ffbb"},
    "6": {"$value": "#5cffa5"},
    "7": {"$value": "#00ec89"},
    "8": {"$value": "#007f47"},
    "9": {"$value": "#00894d"},
    "10": {"$value": "#009353"},
    "11": {"$value": "#004021"},
    "12": {"$value": "#001306"},
    "contrast": {"$value": "#000000"}
  },
  "red": {
    "$type": "color",
    "$description": "Rerun's Red scale, light side first.",
    "1": {"$value": "#fffcfd"},
    "2": {"$value": "#fff9f9"},
    "3": {"$value": "#ffeff0"},
    "4": {"$value": "#ffe2e5"},
    "5": {"$value": "#ffd1d6"},
    "6": {"$value": "#ffbdc5"},
    "7": {"$value": "#ff99a6"},
    "8": {"$value": "#db0049"},
    "9": {"$value": "#ec004f"},
    "10": {"$value": "#fd0056"},
    "11": {"$value": "#ab0037"},
    "12": {"$value": "#480012"},
    "contrast": {"$value": "#ffffff"}
  },
  "surface": {
    "$type": "color",
    "canvas": {"$value": "{gray.0}"},
    "panel": {"$value": "{gray.0}"},
    "raised": {"$value": "{gray.2}"},
    "hover": {"$value": "{gray.4}"},
    "active": {"$value": "{gray.5}"},
    "overlay": {"$value": "{gray.0}"},
    "sunken": {"$value": "{gray.3}"}
  },
  "border": {
    "$type": "color",
    "default": {"$value": "{gray.5}", "$description": "Gray.800: Rerun's divider is Gray.700 at half a point; a full point of it would not set the accent apart on a track"},
    "strong": {"$value": "{gray.9}"}
  },
  "selection": {"$type": "color", "$value": "{blue.5}", "$description": "Blue.800: a selection under ordinary text; selected rows take Rerun's selection_bg_fill (list-row)."},
  "warning": {"$type": "color", "$value": "#b35000", "$description": "warn_fg_color (#FF7A0C) darkened in OKLCH for contrast on white."},
  "focus": {
    "$type": "color",
    "ring": {"$value": "{blue.9}"}
  },
  "button": {
    "rest": {
      "fill": {"$type": "color", "$value": "{gray.4}"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}}
    },
    "hover": {
      "fill": {"$type": "color", "$value": "{gray.5}"}
    },
    "danger": {
      "$type": "color",
      "$description": "Helios component tokens: the primary button of a destructive dialog.",
      "background": {"$value": "{red.8}", "$description": "Red.475: Rerun's Red.500 carries white text at 4.49:1 only, a step darker reads at 5.1:1."},
      "text": {"$value": "{red.contrast}"}
    }
  },
  "tab": {
    "padding-x": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.panel}"},
      "border-width": {"$type": "dimension", "$value": {"value": 0, "unit": "px"}},
      "text": {"$type": "color", "$value": "{gray.10}"}
    },
    "hover": {
      "text": {"$type": "color", "$value": "{gray.11}"}
    },
    "selected": {
      "fill": {"$type": "color", "$value": "{surface.panel}"},
      "text": {"$type": "color", "$value": "{gray.12}"}
    }
  },
  "list-row": {
    "rest": {
      "text": {"$type": "color", "$value": "{text.default}"}
    },
    "hover": {
      "fill": {"$type": "color", "$value": "{gray.2}", "$description": "list_item_hovered_bg"}
    },
    "selected": {
      "fill": {"$type": "color", "$value": "{blue.9}", "$description": "selection_bg_fill (Blue.500)"},
      "text": {"$type": "color", "$value": "{blue.contrast}"}
    }
  },
  "chart": {
    "$type": "color",
    "$description": "The categorical palette's hues (palette.category aliases them, in order), egui-pop's own hue per slot with its lightness fitted to Rerun's white surfaces: 3:1 on them, and apart as contrast::check_category asks.",
    "blue": {"$value": "#066899"},
    "orange": {"$value": "#cd7804"},
    "green": {"$value": "#01553e"},
    "pink": {"$value": "#912a8f"},
    "olive": {"$value": "#746304"},
    "periwinkle": {"$value": "#3e2da4"},
    "lime": {"$value": "#449504"},
    "red": {"$value": "#e85881"},
    "teal": {"$value": "#069bb2"},
    "purple": {"$value": "#8960da"}
  },
  "palette": {
    "log": {
      "$type": "color",
      "$description": "The text log's levels, as Rerun's light theme colours them.",
      "trace": {"$value": "#2c2b2b", "$description": "Gray.300: trace_log_text_color"},
      "debug": {"$value": "{blue.9}", "$description": "Blue.500: debug_log_text_color"},
      "info": {"$value": "{green.8}", "$description": "Green.475: info_log_text_color is Green.500, at 4.48:1 on white; a step darker reads at 4.5:1"},
      "warn": {"$value": "{warning}", "$description": "warn_fg_color (#FF7A0C), darkened as `warning` is for contrast on white"},
      "error": {"$value": "#ab0116", "$description": "error_fg_color"},
      "critical": {"$value": "{red.12}", "$description": "Red.200: Rerun draws critical in strong_fg_color (Gray.0) on error_fg_color; as a text colour, the red nearest the strong text"}
    }
  },
  "viewport": {
    "background": {"$type": "color", "$value": "{viewport.surround}", "$description": "egui-pop's viewport: around the image, the surround."},
    "surround": {"$type": "color", "$value": "#808080", "$description": "Helios component token: behind the photo being edited. Neutral mid grey, not Rerun's white: a white surround would make a photo look darker than it is."},
    "backdrop": {"$type": "color", "$value": "{viewport.surround}", "$description": "egui-pop's viewport: under the image until its tiles arrive, the surround too."}
  },
  "state": {
    "$type": "color",
    "$description": "Helios component tokens: the state of a node in the graph.",
    "done": {"$value": "{success}", "$description": "A node computed and current."},
    "running": {"$value": "{info}", "$description": "A node being computed."},
    "stale": {"$value": "{text.muted}", "$description": "A node whose content is out of date."},
    "failed": {"$value": "{danger}", "$description": "A node whose computation failed."},
    "pending": {"$value": "{accent.default}", "$description": "A decision waiting for an answer."}
  },
  "mask": {
    "overlay": {
      "$description": "Helios component tokens: a mask shown over the image (the mask display's overlay).",
      "color": {"$type": "color", "$value": "{accent.default}", "$description": "Laid over the image where the mask applies, by the mask's value: Rerun's blue, which reads on the greyed image."},
      "opacity": {"$type": "number", "$value": 0.6, "$description": "How much of the colour where the mask is full (0 to 1)."},
      "desaturate": {"$type": "number", "$value": 1.0, "$description": "How far the image under the overlay turns grey (0 its colours, 1 grey, as darktable shows it), so the colour reads on any photo."}
    }
  }
}
