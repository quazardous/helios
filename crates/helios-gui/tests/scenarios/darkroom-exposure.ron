// An image opened in the darkroom, its exposure raised.
// Run live by tools/bench/scenarios.py: `$image` is a photo the run made.
Scenario(
    name: "darkroom-exposure",
    description: "An image opened in the darkroom by its path, then its exposure set and read back.",
    steps: [
        Wait(Settled),
        Call("workbench.quickOpen.go", { "item": "file:$image" }),
        Wait(Event("command.done")),
        Wait(Settled),
        Shot("opened"),
        Call("param.set", { "path": "node/exposure/exposure", "value": 0.5 }),
        Wait(Event("command.done")),
        Call("param.get", { "path": "node/exposure/exposure" }),
        Wait(Event("command.done")),
        Expect(Journal(has: "command.done", data: { "command": "param.get", "result": { "value": 0.5 } })),
        Wait(Settled),
        Expect(NoError),
        Shot("exposed"),
    ],
)
