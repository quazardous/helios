{
  "version": 1,
  "values": {
    "x": { "type": "float", "label": "org-example-radial-x", "min": -10000, "max": 10000, "default": 0 },
    "y": { "type": "float", "label": "org-example-radial-y", "min": -10000, "max": 10000, "default": 0 },
    "radius": { "type": "float", "label": "org-example-radial-radius", "min": 0, "max": 10000, "default": 100 },
    "feather": { "type": "float", "label": "org-example-radial-feather", "min": 0, "max": 10000, "default": 25 },
    "exposure": { "type": "float", "label": "org-example-radial-exposure", "min": -4, "max": 4, "default": 1 }
  },
  "tools": [
    {
      "name": "radial",
      "label": "org-example-radial-tool",
      "handles": {
        "format": "egui_hud-handles/1",
        "handles": [
          { "name": "centre", "kind": "point", "centre": { "x": "x", "y": "y" }, "look": "move" },
          { "name": "radius", "kind": "radius", "centre": { "x": "x", "y": "y" }, "radius": "radius" },
          {
            "name": "feather",
            "kind": "feather",
            "centre": { "x": "x", "y": "y" },
            "radius": "radius",
            "feather": "feather",
            "reset": 25.0
          }
        ]
      },
      "ranges": { "feather": [0, 200] }
    }
  ]
}
