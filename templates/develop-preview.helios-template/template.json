{
  "format": 1,
  "id": "helios.develop-preview",
  "version": 2,
  "meta": {
    "name": "Develop (preview)",
    "scenario": "Develop the picture with exposure and a sigmoid tone curve, the image large, its parameters and scopes beside. A raw file is developed from its sensor data, as “Develop one image” does; a picture is developed as it is.",
    "tags": ["develop", "tone"]
  },
  "network": {
    "sources": ["source"],
    "image_sources": ["source"],
    "nodes": [
      { "name": "exposure", "module": "exposure",
        "raw_params": { "exposure": { "float": 0.7 }, "black": { "float": -0.000244140625 }, "compensate_bias": { "bool": true } } },
      { "name": "sigmoid", "module": "sigmoid" }
    ],
    "connections": [
      { "from": "source", "port": "image", "to": "exposure", "input": "input" },
      { "from": "exposure", "port": "output", "to": "sigmoid", "input": "input" }
    ],
    "view": { "node": "sigmoid", "port": "output" }
  }
}
