#!/usr/bin/env bash
# bwrap for flatpak and flatpak-builder in the bench box's jobs, set with
# FLATPAK_BWRAP. A box job's container type refuses two things flatpak
# asks of bwrap:
#
# - forbidding user namespaces inside the sandbox (`--disable-userns`),
#   which writes /proc/sys/user/max_user_namespaces in the new namespace:
#   every build step and `flatpak run` failed;
# - a new network namespace ("Creating new namespace failed"), which
#   flatpak asks for its own helpers (`ldconfig` before a run, the icon
#   check) through `--unshare-net` or `--unshare-all`; the app itself
#   shares the network (`--share=network`).
#
# This drops `--disable-userns` and keeps the network shared (on the
# command line and in an `--args FD` list), then runs the real bwrap,
# inside the job's still confined container. The bundle built is the
# same; what users run keeps flatpak's defaults.
set -euo pipefail

real=/usr/bin/bwrap

# one argument rewritten, printed NUL-terminated
rewrite() {
  case "$1" in
    --disable-userns | --assert-userns-disabled | --unshare-net) ;;
    --unshare-all) printf '%s\0' --unshare-all --share-net ;;
    *) printf '%s\0' "$1" ;;
  esac
}

args=()
while [ $# -gt 0 ]; do
  if [ "$1" = --args ]; then
    # NUL-separated arguments read from a file descriptor
    tmp="$(mktemp)"
    while IFS= read -r -d '' a; do rewrite "$a"; done <"/proc/self/fd/$2" >"$tmp"
    exec {fd}<"$tmp"
    rm -f "$tmp"
    args+=(--args "$fd")
    shift 2
    continue
  fi
  while IFS= read -r -d '' a; do args+=("$a"); done < <(rewrite "$1")
  shift
done
exec "$real" "${args[@]}"
