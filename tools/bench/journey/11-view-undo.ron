// The first-user journey, step 11: view state is never an undo step
// (undo history, slice R1), and Ctrl+Z follows the focused view (R3). On
// the photo still open in the darkroom, two real edits (the exposure set
// twice), then a workspace change after them (a node added to the
// network); then panels opened, the Library sorted and culling's
// auto-advance turned on, which are view state. With the image focused,
// Edit > Undo (what Ctrl+Z runs) undoes the exposure, not the newer
// workspace change, and nothing of the view; with the graph focused, it
// undoes the workspace change and leaves the exposure; with the focus
// on a panel naming no history, it still goes to the view focused last.
// tools/bench/journey.py then reads the sort and auto-advance back: still
// as they were left.
Scenario(
    name: "view-undo",
    description: "Opening panels, sorting and auto-advance add no undo step; Undo follows the focused view, or the one focused last.",
    steps: [
        Window("main"),
        Wait(Settled),
        Call("param.set", { "path": "node/exposure/exposure", "value": 0.5 }),
        Wait(Event("command.done")),
        Call("param.set", { "path": "node/exposure/exposure", "value": 1.25 }),
        Wait(Event("command.done")),
        Expect(Value("helios.values.node/exposure/exposure", 1.25)),
        Call("network.add", { "nodes": [{ "module": "sigmoid" }] }),
        Wait(Event("command.done")),
        Wait(Settled),
        Call("egui_pop.history.focus", ()),
        Wait(Settled),
        Call("library.sort", { "by": "name" }),
        Wait(Event("command.done")),
        Call("vault.autoAdvance", { "on": true }),
        Wait(Event("command.done")),
        Wait(Settled),
        // The image's view: its edit, though the workspace's step is newer.
        Call("helios.viewport.focus", ()),
        Wait(Settled),
        Call("edit.undo", ()),
        Wait(Event("command.done")),
        Expect(Value("helios.values.node/exposure/exposure", 0.5)),
        Wait(Settled),
        // The graph: the workspace's change, the exposure left alone.
        Call("helios.graph.focus", ()),
        Wait(Settled),
        Call("edit.undo", ()),
        Wait(Event("command.done")),
        Expect(Journal(has: "command.done", data: { "command": "edit.undo", "result": { "scope": "workspace" } })),
        Expect(Value("helios.values.node/exposure/exposure", 0.5)),
        Wait(Settled),
        // The focus lost: a new edit, the image focused, then the History
        // panel focused, which names no history. Edit > Undo still goes to
        // the image's history (the view focused last in the window), and
        // no message says that no view was focused.
        Call("param.set", { "path": "node/exposure/exposure", "value": 2.0 }),
        Wait(Event("command.done")),
        Call("helios.viewport.focus", ()),
        Wait(Settled),
        Call("egui_pop.history.focus", ()),
        Wait(Settled),
        Call("edit.undo", ()),
        Wait(Event("command.done")),
        Expect(Value("helios.values.node/exposure/exposure", 0.5)),
        Expect(Tree(lacks: (label: "Nothing to undo here: click a view first"))),
        Wait(Settled),
        Expect(NoError),
        Shot("undone"),
    ],
)
