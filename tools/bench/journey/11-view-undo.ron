// The first-user journey, step 11: view state is never an undo step
// (undo history, slice R1). On the photo still open in the darkroom, two real edits
// (the exposure set twice); then panels opened, the Library sorted and
// culling's auto-advance turned on, which are view state; Edit > Undo
// (what Ctrl+Z runs) then undoes the last real edit, the exposure, and
// nothing of the view. tools/bench/journey.py then reads the sort and
// auto-advance back: still as they were left.
Scenario(
    name: "view-undo",
    description: "Opening panels, sorting and auto-advance add no undo step; Undo undoes the last real edit.",
    steps: [
        Window("main"),
        Wait(Settled),
        Call("param.set", { "path": "node/exposure/exposure", "value": 0.5 }),
        Wait(Event("command.done")),
        Call("param.set", { "path": "node/exposure/exposure", "value": 1.25 }),
        Wait(Event("command.done")),
        Expect(Value("helios.values.node/exposure/exposure", 1.25)),
        Call("egui_pop.history.focus", ()),
        Wait(Settled),
        Call("library.sort", { "by": "name" }),
        Wait(Event("command.done")),
        Call("vault.autoAdvance", { "on": true }),
        Wait(Event("command.done")),
        Wait(Settled),
        Call("edit.undo", ()),
        Wait(Event("command.done")),
        Expect(Value("helios.values.node/exposure/exposure", 0.5)),
        Wait(Settled),
        Expect(NoError),
        Shot("undone"),
    ],
)
