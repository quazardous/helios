// The first-user journey, step 7: Settings › Storage on the new library,
// then Backup › Strategy with its line ("No backup set up" on a new
// library). Run live by tools/bench/journey.py, which also reads the
// volumes (`library.volumes`: the library's disk, online) and the
// strategy (`library.backupStrategy`).
Scenario(
    name: "storage",
    description: "Settings › Storage shows the library's disk, and the backup strategy its line, without an error.",
    steps: [
        Window("main"),
        Wait(Settled),
        Call("library.storage", {}),
        Wait(Settled),
        Window("settings"),
        Expect(Value("admin.scope", "storage")),
        Expect(Value("admin.section", "volumes")),
        Expect(NoError),
        Shot("volumes"),
        Call("admin.open", { "path": "backup/strategy" }),
        Wait(Settled),
        Expect(Value("admin.scope", "backup")),
        Expect(Tree(has: (label: "No backup set up"))),
        Expect(NoError),
        Shot("strategy"),
    ],
)
