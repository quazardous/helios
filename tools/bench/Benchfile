# Helios's jobs on a bench box (a self-service remote runner, see
# docs/bench.md), as a Benchfile: the image, where the code comes from, and
# what each job runs and requests (threads, a memory estimate, exclusive
# resources, mounts, a timeout). The box refuses a request above its
# envelope (`config show`) and learns each job's real memory peak.
#
#   run <job> branch=<branch>          a branch pushed to GitHub
#   run <job> branch=<b> src=helios-local-<id>
#                                      code sent with `push helios-local-<id>`
#                                      (cargo xtask bench-remote --push)
#   debug <job> branch=<branch>        (ssh -t) a shell in the job's container
#
# Upload it with `config benchfile < tools/bench/Benchfile`. Each job has
# its own checkout at /work/helios, so jobs on different branches run side
# by side; the target directory is kept per branch and used by one job at a
# time, the cargo registry is shared. Jobs run without network: [fetch]
# downloads the crates first. Results land in /out, fetched with
# `fetch <id>`.

# Helios's space on the box: the per-branch target caches, the registry and
# the image: several egui-pop branches at ~10 GB each run at once (applied
# on upload, within the box's envelope)
[project]
disk = "60g"

[image]
from = "registry.fedoraproject.org/fedora:44"
run = [
  # build tools; Mesa's lavapipe (software Vulkan) for the GPU backend and
  # the GUI snapshot tests; labwc for headless GUI runs through wbox
  """dnf -y install git-core gcc gcc-c++ make pkgconf-pkg-config findutils procps-ng \
      tar xz which python3 wayland-devel libxkbcommon-devel \
      mesa-vulkan-drivers vulkan-loader vulkan-tools labwc sccache \
 && dnf clean all""",
  # every download is pinned and checked: rustup-init 1.29.1 (its published
  # sha256), cargo-nextest 0.9.148, wbox-mcp at a commit
  # the toolchain of rust-toolchain.toml, outside CARGO_HOME (a cache)
  """curl -sSfL -o /tmp/rustup-init \
      https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init \
 && echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && CARGO_HOME=/opt/cargo /tmp/rustup-init -y --no-modify-path \
      --profile minimal --default-toolchain 1.95 -c clippy -c rustfmt \
 && rm /tmp/rustup-init""",
  """curl -sSfL -o /tmp/nextest.tar.gz \
      https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-0.9.148/cargo-nextest-0.9.148-x86_64-unknown-linux-gnu.tar.gz \
 && echo "223ba936714cc861a9cdedad5a8eb664dfdd69d6fbdf6cea6aa8184f523290dc  /tmp/nextest.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/nextest.tar.gz -C /usr/local/bin && rm /tmp/nextest.tar.gz""",
  # darktable's build dependencies (Fedora's own list), for the
  # darktable-cli the mask-parity job builds
  """dnf -y install dnf-plugins-core \
 && dnf -y builddep darktable \
 && dnf -y install cmake ninja-build \
 && dnf clean all""",
  # wbox drives a headless labwc (no job uses it yet; debug shells may)
  """python3 -m venv /opt/wbox \
 && /opt/wbox/bin/pip install --quiet \
      "git+https://github.com/quazardous/wbox-mcp.git@a2f3eab914e7d1db142f98887a3be623a6821402\"""",
]
# CARGO_HOME is the registry cache; the toolchain lives in /opt. Line
# tables only and no incremental state keep the per-branch target small.
env = { RUSTUP_HOME = "/opt/rustup", CARGO_HOME = "/cargo", PATH = "/opt/cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin", CARGO_TARGET_DIR = "/target", CARGO_INCREMENTAL = "0", RUSTC_WRAPPER = "sccache", SCCACHE_DIR = "/sccache", SCCACHE_CACHE_SIZE = "12G", CARGO_PROFILE_DEV_DEBUG = "line-tables-only", CARGO_PROFILE_TEST_DEBUG = "line-tables-only", RUST_BACKTRACE = "1", VKDT_SRC = "/work/vkdt", WBOX_PYTHON = "/opt/wbox/bin/python3", WLR_RENDERER = "pixman", HOME = "/tmp/home", XDG_RUNTIME_DIR = "/tmp/xdg" }

[checkout.helios]
repo = "https://github.com/quazardous/helios.git"
ref = "${branch:-main}"
submodules = true

# vkdt's module files, read by the manifest round-trip test, at the commit
# the converter was checked on (the same as CI)
[checkout.vkdt]
repo = "https://github.com/hanatos/vkdt.git"
ref = "afc34256fb22bcaf6dcf6503d19d5f9a6f477af5"

# egui-pop, Helios's UI library: its own jobs below; `egui_pop=<branch>`
# picks the branch (main by default), `src=egui-pop-local` runs pushed code
[checkout.egui-pop]
repo = "https://github.com/quazardous/egui-pop.git"
ref = "${egui_pop:-main}"

# darktable for the drawn-mask parity (docs/masks.md, "Parity with
# darktable"): upstream at the base of the flexi masks pull request
# (darktable-org/darktable#22553), and the pull request's head, both
# pinned. Its submodules are checkouts of their own at the commits both
# pin (darktable's tests submodule, 2 GB of images, is left out).
[checkout.darktable]
repo = "https://github.com/darktable-org/darktable.git"
ref = "ca5a02038b93e41dc96231ad80837fe5c54f4fbd"

[checkout.darktable-flexi]
repo = "https://github.com/darktable-org/darktable.git"
ref = "5a6425e7887039adc2a8982123290d9415c483bb"

[checkout.rawspeed]
repo = "https://github.com/darktable-org/rawspeed.git"
ref = "c835b05aecfacb7343f7c424abd620aa12116c3f"

[checkout.whereami]
repo = "https://github.com/gpakosz/whereami.git"
ref = "e07bc35ecd92ee4c3ac71cf0fb6b01132bfa50de"

[checkout.libraw]
repo = "https://github.com/LibRaw/LibRaw.git"
ref = "f74ddd995c5447458f132a5377ca0f4b394dff6e"

# the job's env applies here too: CARGO_NET_OFFLINE is lifted for the fetch
[fetch]
# a job fetches only its own checkouts: skip the ones it does not have
run = ["for d in /work/helios /work/egui-pop /work/${src:-helios}; do [ -d $d ] || continue; (cd $d && CARGO_NET_OFFLINE=false cargo fetch --locked) || exit 1; done"]

# Helios's own directories on the box. Build trees are keyed by the branch
# they build (Helios's `branch`, egui-pop's `egui_pop`), so neither needs the
# other's parameter; all of it regenerates (tmp, the default).
[storage]
target = { about = "Helios's cargo target directories, one per branch, a new one starting from main's", lock = true, seed = "main" }
egui-pop-target = { about = "egui-pop's cargo target directories, one per egui-pop branch, a new one starting from main's", lock = true, seed = "main" }
registry = "the cargo registry, shared by every job"
darktable-build = { about = "darktable-cli builds for the mask parity, one per pinned checkout", lock = true }
cargo-git = "the cargo git dependencies, shared by every job"
sccache = "sccache's compile cache, shared by every job and branch: a branch reuses what another compiled"

# Every job builds from a copy at a fixed path (/tmp/w/<repo>): the target
# cache is shared by branch runs (/work/helios) and pushed code
# (/work/helios-local-<id>), and cargo does not rebuild a workspace that only
# moved, so env!("CARGO_MANIFEST_DIR") would point at the other place. A
# cache built anywhere else (its /target/.built-at says where) starts empty.

# ---------------------------------------------------------------- correctness

[jobs.build]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 5
memory = "6g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo build --workspace --all-targets --locked"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# fast compile and lint feedback: clippy on every target, the repository
# checks (changelog fragments...), the translation catalogues' coverage
# in /out/i18n.txt
[jobs.lint]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 5
memory = "6g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo clippy --workspace --all-targets --locked -- -D warnings \
 && cargo xtask check \
 && cargo xtask i18n check | tee /out/i18n.txt; exit ${PIPESTATUS[0]}"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# the CI profile (no retry, no fail-fast), its JUnit report and a Markdown
# summary of the slowest tests in /out
[jobs.test]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 5
memory = "6g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo nextest run --workspace --locked --profile ci; rc=$?; \
cp target/nextest/ci/junit.xml /out/ \
 && cargo xtask test-times --from-junit /out/junit.xml --summary > /out/summary.md; \
exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# the tests a change touches (base=<commit or branch>, origin/main by
# default): `cargo xtask affected` maps the files changed since the merge
# base to the crates and their dependents, plus the critical set (smoke
# render, load and save round trip, survival); its selection in
# /out/affected.json, the JUnit report and the slowest tests in /out
[jobs.test-affected]
cores = 5
memory = "6g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && \
cargo xtask affected ${base:-origin/main} > /out/affected.json && filter=$(cargo xtask affected ${base:-origin/main} --filter) || exit 1; \
cargo nextest run --workspace --locked --profile ci -E "$filter"; rc=$?; \
cp target/nextest/ci/junit.xml /out/ \
 && cargo xtask test-times --from-junit /out/junit.xml --summary > /out/summary.md; \
exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# quit, kill -9 and reopen: the scenarios that gate a release
[jobs.survival]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 4
memory = "4g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo survival --locked"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "30m"

# every commit of base..HEAD but the head builds and passes the fast tests
# (base=<commit or branch>, origin/main by default)
[jobs.check-commits]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 5
memory = "6g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo xtask check-commits ${base:-origin/main}"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "2h"

# the GPU backend's tests on the box's NVIDIA GPU, not lavapipe
[jobs.gpu]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 4
memory = "4g"
resources = ["gpu"]
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cp "$BENCH_RESOURCES" /out/resources.json 2> /dev/null; \
cargo test -q --locked -p helios-gpu --test backend -- --nocapture 2>&1 | grep -E '^(GPU|skipped):' | sort -u | tee /out/adapter.txt; \
cargo nextest run --locked --profile ci -p helios-gpu -p helios-compute; rc=$?; \
cp target/nextest/ci/junit.xml /out/; exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "30m"

# the same tests on the Intel iGPU (Mesa ANV), the second real backend
[jobs.gpu-intel]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 4
memory = "4g"
resources = ["render"]
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cp "$BENCH_RESOURCES" /out/resources.json 2> /dev/null; \
cargo test -q --locked -p helios-gpu --test backend -- --nocapture 2>&1 | grep -E '^(GPU|skipped):' | sort -u | tee /out/adapter.txt; \
cargo nextest run --locked --profile ci -p helios-gpu -p helios-compute; rc=$?; \
cp target/nextest/ci/junit.xml /out/; exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "30m"

# egui-pop's gate: fmt, clippy, the workspace tests with the doctests, docs
[jobs.egui-pop-gate]
checkouts = ["egui-pop"]
cores = 5
memory = "7g"
cwd = "/work/${src:-egui-pop}"
command = """mkdir -p /tmp/w/egui-pop && cp -r --preserve=mode . /tmp/w/egui-pop/ && cd /tmp/w/egui-pop && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/egui-pop ] || { rm -rf /target/* && echo /tmp/w/egui-pop > /target/.built-at; }; } && cargo fmt --all --check \
 && cargo clippy --workspace --all-targets --locked -- -D warnings \
 && cargo test --workspace --locked \
 && RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps --locked"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "egui-pop-target/${egui_pop:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# egui-pop's gallery snapshots regenerated (UPDATE_SNAPSHOTS=1, on lavapipe
# as in CI): every PNG of crates/egui-pop-gallery/tests/snapshots lands in
# /out/snapshots, to review and commit
[jobs.egui-pop-snapshots]
checkouts = ["egui-pop"]
cores = 5
memory = "7g"
cwd = "/work/${src:-egui-pop}"
command = """mkdir -p /tmp/w/egui-pop && cp -r --preserve=mode . /tmp/w/egui-pop/ && cd /tmp/w/egui-pop && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/egui-pop ] || { rm -rf /target/* && echo /tmp/w/egui-pop > /target/.built-at; }; } && \
UPDATE_SNAPSHOTS=1 cargo test --locked -p egui-pop-gallery --test gallery; rc=$?; \
mkdir -p /out/snapshots && find crates/egui-pop-gallery/tests/snapshots -name '*.png' ! -name '*.new.png' ! -name '*.old.png' ! -name '*.diff.png' -exec cp -t /out/snapshots/ {} + ; \
exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "egui-pop-target/${egui_pop:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# egui-pop's translation catalogues regenerated (UPDATE_CATALOGUES=1: the
# English one from the code, new translations stamped): the locales of
# crates/egui-pop-i18n land in /out/locales, to review and commit
[jobs.egui-pop-catalogues]
checkouts = ["egui-pop"]
cores = 5
memory = "7g"
cwd = "/work/${src:-egui-pop}"
command = """mkdir -p /tmp/w/egui-pop && cp -r --preserve=mode . /tmp/w/egui-pop/ && cd /tmp/w/egui-pop && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/egui-pop ] || { rm -rf /target/* && echo /tmp/w/egui-pop > /target/.built-at; }; } && \
UPDATE_CATALOGUES=1 cargo test --locked -p egui-pop-i18n --test catalogues; rc=$?; \
cp -r crates/egui-pop-i18n/locales /out/ ; \
exit $rc"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "egui-pop-target/${egui_pop:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# ---------------------------------------------------------------- raw corpus
# The decoder and camera-name regression corpus (docs/raw-corpus.md): the
# "core" raws of tests/raw-corpus.toml, CC0 files from raw.pixls.us checked
# against their sha256, in a volume of their own (under 3 GB). Fill it, or
# refill it after the manifest changes, with
# `provision raw-corpus branch=<branch>`: each provision builds a new
# version and switches to it only on success.
[volumes.raw-corpus]
about = "the raw regression corpus: CC0 raws from raw.pixls.us"
readers = []
cwd = "/work/helios"
provision = "tools/bench/fill-corpus.sh /volume"
timeout = "30m"

# every corpus raw decodes, names its camera and keeps its sensor
# description and thumbnail; JUnit, a summary, what each file gave and the
# thumbnails in /out. `bless=yes` accepts the thumbnails as they are now:
# the new tests/raw-corpus.thumbs.toml lands in /out, to commit.
[jobs.raw-corpus]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 4
memory = "4g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && \
flag=; [ "${bless:-no}" = yes ] && flag=--bless; \
cargo run -q --locked -p helios-corpus -- --dir /corpus --out /out $flag"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", raw-corpus = "/corpus", sccache = "/sccache" }
timeout = "30m"

# ---------------------------------------------------------------- mask parity
# Drawn masks against darktable (docs/masks.md, "Parity with darktable"):
# builds darktable-cli from both pinned checkouts once (kept in the
# darktable-build storage until a pin changes), harvests the fixtures'
# masks with the flexi build (/out/harvest.json, darktable's own decoding,
# kept as tests/masks/harvest.json), then renders each fixture
# of tests/masks/ on its raw of the corpus with darktable-cli and with
# Helios, and compares the masks in Delta E. JUnit, a summary, the numbers
# and both masks as images in /out.
[jobs.mask-parity]
cores = 8
memory = "8g"
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && \
for dt in classic:/work/darktable flexi:/work/darktable-flexi; do \
  DT_JOBS=6 tools/bench/build-darktable.sh ${dt#*:} /work/rawspeed /work/whereami /work/libraw /dt/${dt%%:*}/build /dt/${dt%%:*}/prefix > /out/darktable-${dt%%:*}-build.log 2>&1 || { tail -50 /out/darktable-${dt%%:*}-build.log; exit 1; }; \
done; \
/dt/flexi/prefix/bin/darktable --configdir /tmp/dt-harvest --harvest-masks-xmp tests/masks /out/harvest.json > /out/harvest.log 2>&1 || echo "harvest failed: see harvest.log"; \
cargo build -q --release --locked -p helios-parity --bin mask-parity \
 && HELIOS_DARKTABLE_CLI=/dt/classic/prefix/bin/darktable-cli /target/release/mask-parity --corpus /corpus --out /out --darktable-flexi /dt/flexi/prefix/bin/darktable-cli"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", raw-corpus = "/corpus", "darktable-build/classic" = "/dt/classic", "darktable-build/flexi" = "/dt/flexi", sccache = "/sccache" }
timeout = "2h"

# ---------------------------------------------------------------- timings
# alone on the machine, so the numbers compare from one run to the next

[jobs.bench-masks]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 8
memory = "6g"
exclusive = ["machine"]
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo xtask bench masks && cp /target/bench/masks.jsonl /out/"""
env = { CARGO_NET_OFFLINE = "true" }
mounts = { "target/${branch:-main}" = "/target", registry = "/cargo/registry", cargo-git = "/cargo/git", sccache = "/sccache" }
timeout = "1h"

# the per-branch history (in the target cache) says which tests got slower
[jobs.test-times]
checkouts = ["helios", "vkdt", "egui-pop"]
cores = 8
memory = "6g"
exclusive = ["machine"]
cwd = "/work/${src:-helios}"
command = """mkdir -p /tmp/w/helios && cp -r --preserve=mode . /tmp/w/helios/ && cd /tmp/w/helios && { [ "$(cat /target/.built-at 2> /dev/null)" = /tmp/w/helios ] || { rm -rf /target/* && echo /tmp/w/helios > /target/.built-at; }; } && cargo xtask test-times --profile ci | tee /out/test-times.txt; rc=${PIPESTATUS[0]}; \
