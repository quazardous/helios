# Generated from Helios's declarations and code by `cargo xtask i18n extract`:
# do not edit. Translations live in i18n/<locale>/ under the same names.

tip-helios-decisions =
    .text = When an edit waits for a decision, the status bar counts it. A click opens the Decisions panel: accept the proposal or give your own answer.
    .title = Decisions waiting

tip-helios-fullscreen =
    .text = { $key } gives the whole screen to Helios. Bring the pointer to the top edge to find the way out, or press { $key } again.
    .title = Full screen

tip-helios-keyboard-shortcuts =
    .text = { $key } lists every keyboard shortcut. Change one there, and Helios shows the new key everywhere, these tips included.
    .title = Your own keys

tip-helios-mask-display =
    .text = With the image focused, { $key } lays the selected mask over it, then shows it alone in grey; press it a third time to hide it.
    .title = See the mask

tip-helios-move-panels =
    .text = Drag a panel by its tab onto another area to move it there. The workspace keeps the layout for next time.
    .title = Arrange the panels

tip-helios-palette =
    .text = { $key } opens the command palette: type a few letters of what you want to do, then Enter runs it.
    .title = Find any command

tip-helios-profiles =
    .text = A profile keeps your theme, keys, layouts and settings together. The Profiles submenu of the Helios menu exports and imports them, and each workspace can name its own.
    .title = Profiles

tip-helios-rate =
    .text = In the library, { $key-vault-rate-0 } to { $key-vault-rate-5 } rate the selected images, { $key-vault-reject } rejects them and { $key } picks them.
    .title = Rate and pick

tip-helios-reset-value =
    .text = A double click on a slider puts its default value back. The dot on its left marks a changed value: a click on it resets too.
    .title = Back to the default

tip-helios-scopes-linear =
    .text = The histogram is drawn in stops, a log scale that gives the shadows as much room as the highlights. { $key } makes it linear, { $key-scopes-stops } brings the stops back.
    .title = Scopes in stops

tip-helios-system-menu =
    .text = { $key }, or the button at the start of the title bar, opens the Helios menu: profiles, themes, keyboard shortcuts and About.
    .title = The Helios menu

tip-helios-typed-values =
    .text = With a slider focused, press Enter to type its value. Units, either decimal mark and expressions such as `x * 2` are accepted.
    .title = Type a value

tip-helios-zoom =
    .text = { $key } fits the image in the view, { $key-viewport-zoom-100 } shows it at 100 %: one image pixel on one screen pixel.
    .title = Fit or 100 %
