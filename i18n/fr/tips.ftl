# Traduction de ../en/tips.ftl, sous les mêmes clés.

tip-helios-decisions =
    .text = Quand une retouche attend une décision, la barre d’état le signale. Un clic ouvre le panneau Décisions : acceptez la proposition ou donnez votre propre réponse.
    .title = Des décisions en attente

tip-helios-fullscreen =
    .text = { $key } donne tout l’écran à Helios. Approchez le pointeur du bord supérieur pour retrouver la sortie, ou appuyez de nouveau sur { $key }.
    .title = Plein écran

tip-helios-keyboard-shortcuts =
    .text = { $key } liste tous les raccourcis clavier. Modifiez-en un : Helios affiche partout la nouvelle touche, jusque dans ces astuces.
    .title = Vos propres raccourcis

tip-helios-mask-display =
    .text = Quand l’image a le focus, { $key } superpose le masque sélectionné à l’image, puis l’affiche seul en gris ; une troisième pression le masque.
    .title = Voir le masque

tip-helios-move-panels =
    .text = Faites glisser un panneau par son onglet vers une autre zone pour l’y déplacer. L’espace de travail garde cette disposition pour la prochaine fois.
    .title = Disposer les panneaux

tip-helios-palette =
    .text = { $key } ouvre la palette de commandes : tapez quelques lettres de ce que vous voulez faire, puis Entrée pour le lancer.
    .title = Trouver n’importe quelle commande

tip-helios-profiles =
    .text = Un profil réunit votre thème, vos raccourcis, vos dispositions et vos réglages. Le sous-menu Profils du menu Helios les exporte et les importe, et chaque espace de travail peut choisir le sien.
    .title = Profils

tip-helios-rate =
    .text = Dans la bibliothèque, { $key-vault-rate-0 } à { $key-vault-rate-5 } notent les images sélectionnées, { $key-vault-reject } les rejette et { $key } les choisit.
    .title = Noter et choisir

tip-helios-reset-value =
    .text = Un double clic sur un curseur lui rend sa valeur par défaut. Le point à sa gauche signale une valeur modifiée : un clic dessus la réinitialise aussi.
    .title = Retour à la valeur par défaut

tip-helios-scopes-linear =
    .text = L’histogramme est tracé en diaphs, une échelle logarithmique qui laisse autant de place aux ombres qu’aux hautes lumières. { $key } le passe en linéaire, { $key-scopes-stops } revient aux diaphs.
    .title = Les mesures en diaphs

tip-helios-system-menu =
    .text = { $key }, ou le bouton au début de la barre de titre, ouvre le menu Helios : profils, thèmes, raccourcis clavier et À propos.
    .title = Le menu Helios

tip-helios-typed-values =
    .text = Quand un curseur a le focus, appuyez sur Entrée pour saisir sa valeur. Les unités, la virgule comme le point et des expressions comme `x * 2` sont acceptées.
    .title = Saisir une valeur

tip-helios-zoom =
    .text = { $key } ajuste l’image à la vue, { $key-viewport-zoom-100 } l’affiche à 100 % : un pixel de l’image pour un pixel de l’écran.
    .title = Ajuster ou 100 %
