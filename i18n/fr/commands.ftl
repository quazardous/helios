command-compare-previous =
    .title = Comparer : rendre active la photo précédente (`surface` : un Comparer, helios.compare#<n> ; sinon celui qui a le focus, sinon le dernier à l'avoir eu dans la fenêtre)

command-compare-sync =
    .title = Comparer : zoom et déplacement synchronisés entre les photos (`on` ; basculé en son absence ; `surface` : un Comparer, helios.compare#<n> ; sinon celui qui a le focus, sinon le dernier à l'avoir eu dans la fenêtre)

command-controls-catalogue =
    .title = Lister les contrôles enregistrés

command-controls-context =
    .title = Lire les clés de contexte des contrôles, leur cadre, leur densité et la main ; en régler n’importe lesquelles (`task`, `detail`, `image`, `tool`, `device`, `target`, `density`, `box`, `layouts`, `gesture_open`, `pointer_in_panel`, `handled`)

command-controls-describe =
    .title = Décrire un contrôle (`id`) : but, connecteur, gestes, crans, variantes, règles d’emplacement, orientations, intégration et repli par surface, avertissements, schéma de réglages ; avec `node`, sa place sur la carte de ce nœud et pourquoi

command-controls-find =
    .title = Chercher les contrôles d’un nœud (`node`, `query`), affichés ou repliés, avec leur place et sa raison

command-controls-nudge =
    .title = Faire avancer un contrôle d’un nœud de quelques pas (`node`, `control`, `steps` ; `fine`, `coarse`)

command-controls-reset =
    .title = Remettre un contrôle d’un nœud à sa valeur par défaut (`node`, `control`)

command-controls-reveal =
    .title = Montrer pour l’instant une partie repliée de la carte d’un nœud (`node`, `key`)

command-controls-reveal-all =
    .title = Montrer pour l’instant toutes les parties de la carte d’un nœud (`node`)

command-controls-set =
    .title = Régler un contrôle d’un nœud (`node`, `control`, `value` ; `force`)

command-compare-add =
    .title = Comparer : ajouter des photos à la comparaison ouverte (`images` : identifiants, sinon la sélection ; `at` : avant la photo à cette place, sinon en dernier ; seize au plus ; `surface` : un autre Comparer, helios.compare#<n>)

command-compare-remove =
    .title = Comparer : retirer des photos de la comparaison (`images` : identifiants, sinon la photo active ; la dernière retirée quitte Comparer ; `surface` : un autre Comparer, helios.compare#<n>)

command-compare-set =
    .title = Comparer : comparer exactement ces photos (`images` : d’un à seize identifiants, dans cet ordre ; `surface` : un autre Comparer, helios.compare#<n>), en entrant dans Comparer

command-compare-clear =
    .title = Comparer : vider la comparaison et quitter Comparer (`surface` : un autre Comparer, helios.compare#<n>, vidé)

command-compare-leave =
    .title = Quitter Comparer : retour à la grille, ou là d’où Comparer a été ouvert (Échap)

command-compare-active =
    .title = Comparer : les photos comparées et la photo active (`image` : rendre active cette photo comparée ; `surface` : un autre Comparer, helios.compare#<n>)

command-library-compare =
    .title = Comparer des photos côte à côte (`images` : identifiants, sinon la sélection ; de deux à quatre)

command-library-sort =
    .title = Trier la bibliothèque (`by` : captured, imported, name, rating, edited, size ou focus ; `descending`) ; gardé avec l’espace de travail. Sans `by`, dit comment elle est triée

command-library-folder =
    .title = Limiter la bibliothèque à un dossier et à ceux qu’il contient (`path`, absolu ; null : toute la bibliothèque) ; gardé avec l’espace de travail. Sans `path`, dit le dossier

command-library-collection =
    .title = Limiter la bibliothèque à un album (`id` ; null : toute la bibliothèque) ; gardé avec l’espace de travail. Sans `id`, dit l’album

command-library-collection-create =
    .title = Nouvel album (`name` ; `images` : identifiants, sinon la sélection), ou avec `kind: smart` un album dynamique (`rules` : un arbre de groupes (`match` : all, any ou none ; `rules`) et de conditions (`field`, `op`, `value`), ou les clés du formulaire), ou avec `kind: set` un ensemble d’albums (`set` : l’ensemble où il va) ; sans `name`, le demande. Répond son `id`

command-library-collection-rename =
    .title = Renommer un album (`id`, `name`) ; sans `name`, le demande

command-library-collection-delete =
    .title = Supprimer un album ou un ensemble (`id`) ; ses photos restent dans la bibliothèque. Les albums d’un ensemble remontent dans l’ensemble où il était, ou avec `members: true` sont supprimés aussi

command-library-collection-move =
    .title = Déplacer un album, un album dynamique ou un ensemble (`id`) dans un ensemble (`set` ; null : le premier niveau) ; un ensemble ne va jamais en lui-même. Sans `set`, le demande

command-library-collection-add =
    .title = Ajouter des photos à un album (`id` ; `images` : identifiants, sinon la sélection)

command-library-collection-remove =
    .title = Retirer des photos d’un album (`id` ; `images` : identifiants, sinon la sélection) ; elles restent dans la bibliothèque

command-library-collection-rules =
    .title = Fixer les règles d’un album dynamique (`id` ; `rules`, un arbre, ou les clés du formulaire) ; sans elles, ouvre l’éditeur de règles sur elles. Les champs inconnus et les règles invalides sont refusés avec la raison

command-library-collection-rules-edit =
    .title = Modifier les règles dans l’éditeur ouvert, une modification annulable à la fois : `edit` (add_condition, add_group, remove, move avec `to`, match avec `match` : all, any ou none, field avec `field`, op avec `op`, value avec `value`, `high` (la seconde borne de between, ou le nombre de within) et `unit` (days, weeks ou months), undo, redo, apply, cancel) à `at`, un chemin d’indices depuis le groupe du haut ([]). Une date de prise de vue prend un jour (AAAA-MM-JJ) ou, avec `op: within`, today, this_year ou last. Répond le brouillon, le défaut de chaque condition et les règles quand elles sont valides

command-library-collection-list =
    .title = Lister les albums : `id`, `name`, `kind` (album, dynamique ou ensemble), l’ensemble `set` où il est, combien de photos chacun contient (un ensemble : celles de ses albums réunies), les `rules` d’un album dynamique ; et le nombre `quick` de la collection rapide
command-library-quick-toggle =
    .title = B : mettre des photos dans la collection rapide cible (`id` : une autre ; `images` : identifiants, sinon la sélection), ou les en retirer quand elle les contient toutes ; restreindre la bibliothèque à l’une d’elles avec `library.collection` et son `id` (la première est `quick`)
command-library-remove =
    .title = Retirer de la bibliothèque : en sortir les photos (`images` : identifiants, sinon la sélection), leurs fichiers intacts ; Ctrl+Z les y remet
