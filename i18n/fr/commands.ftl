command-library-rotateLeft =
    .title = Rotation à gauche : tourner les photos d’un quart de tour dans le sens inverse des aiguilles d’une montre (`images` : identifiants, sinon la sélection) ; Ctrl+Z les remet
command-library-rotateRight =
    .title = Rotation à droite : tourner les photos d’un quart de tour dans le sens des aiguilles d’une montre (`images` : identifiants, sinon la sélection) ; Ctrl+Z les remet
command-library-trash =
    .title = Mettre à la corbeille… : les fichiers des photos dans la corbeille du système (`images` : identifiants, sinon la sélection), demandé d’abord sauf `confirmed` ; refusé sur les cartes et les volumes de sauvegarde, les photos sortent de la bibliothèque ; la corbeille du système l’annule, pas Ctrl+Z
command-library-duplicate =
    .title = Dupliquer : une nouvelle version de chaque photo à partir de son développement actuel, à côté des autres (`images` : identifiants, sinon la sélection) ; la grille compte les versions
