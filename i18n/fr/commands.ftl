    .title = Dupliquer l’original : une nouvelle version de chaque photo sans développement, à côté des autres (`images` : identifiants, sinon la sélection)
command-library-removeVersion =
    .title = Supprimer la version… : supprimer une copie d’une photo avec les développements qu’elle seule contient (`image` : un identifiant, sinon la photo sous le curseur ; `version` : l’identifiant d’une tête, sinon sa version actuelle), demandé d’abord sauf `confirmed` ; une photo garde une version ; Ctrl+Z la ramène
command-library-stack-group =
    .title = Grouper en pile : les photos dans une pile (`images` : identifiants, sinon la sélection ; `top` : la photo du dessus, sinon celle sous le curseur), les piles où elles sont fusionnées ; Ctrl+Z l’annule
