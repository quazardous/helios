command-library-files-unpair =
    .title = Séparer les fichiers : chaque fichier des photos (`images` : identifiants, sinon la sélection) redevient une photo, avec une copie des marques de la photo et ses propres versions ; Ctrl+Z les apparie à nouveau
command-library-deleteRejected =
    .title = Supprimer les rejetées… : les photos rejetées affichées dans la corbeille du système (`images` : parmi elles, celles nommées), demandé d’abord sauf `confirmed`
command-library-quick-clear =
    .title = Vider une collection rapide (`id` ; sans : la cible) ; ses photos restent dans la bibliothèque
command-library-quick-saveAs =
    .title = Enregistrer une collection rapide (`id` ; sans : la cible) comme album (`name` ; `clear` : la vider aussi) ; sans `name`, le demande. Répond l’`id` de l’album
command-library-quick-move =
    .title = Déplacer des photos vers une collection rapide (`id` ; sans : la cible) depuis une autre (`from`) : `images`, identifiants, sinon la sélection ; une seule étape. Un glisser d’une collection rapide à une autre le fait, Ctrl copie

command-library-quick-open =
    .title = Ouvrir une collection rapide (`id` ; sans : la cible) dans son propre panneau (`place` : last, here ou une zone) : ses photos, celles qu’on y dépose y entrent. Répond l’id du panneau (`view`)

command-library-quick-add =
    .title = Ajouter des photos à une collection rapide (`id` ; sans : la cible ; `images` : identifiants, sinon la sélection)
command-library-quick-create =
    .title = Nouvelle collection rapide (`name` ; `images` : identifiants, aucune par défaut ; `target: true` en fait la cible) ; sans `name`, le demande. Répond son `id`
command-library-quick-delete =
    .title = Supprimer une collection rapide (`id`), sauf la première (`quick`) ; ses photos restent dans la bibliothèque. Si c’était la cible, la première le redevient
command-library-quick-list =
    .title = Lister les collections rapides, la première d’abord : `id`, `name` (aucun pour la première tant qu’elle n’est pas renommée), `count`, `target` (vrai pour la cible de B)
command-library-quick-remove =
    .title = Retirer des photos d’une collection rapide (`id` ; sans : la cible ; `images` : identifiants, sinon la sélection) ; elles restent dans la bibliothèque
command-library-quick-rename =
    .title = Renommer une collection rapide (`id`, `name`) ; sans `name`, le demande
command-library-quick-target =
    .title = Faire d’une collection rapide (`id`) la cible : B et les dépôts sur elle y mettent les photos

command-library-select-none =
    .title = Ne sélectionner aucune photo, le curseur retiré aussi

command-library-select-invert =
    .title = Inverser la sélection : les photos affichées qui n’étaient pas sélectionnées

command-library-select-similar =
    .title = Sélectionner les photos affichées semblables aux photos sélectionnées (`by` : day, prises le même jour, par défaut ; ou stack, dans la même pile)

command-library-marks-copy =
    .title = Copier les marques d’une photo : note, étiquettes de couleur, mots-clés et titre (`image` : un identifiant, sinon la photo sous le curseur). Les répond

command-library-marks-paste =
    .title = Coller les marques copiées (`images` : identifiants, sinon la sélection ; `marks` : parmi rating, labels, tags, title, toutes par défaut ; `mode` : merge, par défaut, ajoute étiquettes et mots-clés, overwrite rend chaque marque identique à la copie)

command-library-scanFolder =
    .title = Analyser un dossier et ceux qu’il contient à la recherche de fichiers nouveaux ou modifiés (`path`), comme la carte des images analyse un volume

command-helios-quit-confirmed =
    .title = Quitter Helios en annulant les tâches en cours

command-helios-quit-unsaved =
    .title = Avant de quitter, une retouche non enregistrée : réessayer l’enregistrement ou quitter sans enregistrer (`value`)

command-helios-window-main =
    .title = Fenêtre principale

command-import-sources-add =
    .title = Ajouter une source d’import, comme le fait l’assistant « Ajouter… » de la fenêtre d’import : `connector` (son identifiant) et ce que demande sa configuration (`path` : un dossier, ou le point de montage d’un volume ; `volume` : l’identifiant ou le nom d’un volume monté ; `account` : un compte du connecteur), puis `name` (sinon celui du dossier, du volume ou du compte), `profile` (l’identifiant d’un profil d’import ; sinon celui par défaut du connecteur, sinon `everyday`), `auto` (true : l’import automatique que propose le connecteur) et `params` (les paramètres propres du connecteur) ; sélectionnée dans la fenêtre d’import quand elle est ouverte

command-library-importAutomatic-pause =
    .title = Suspendre les imports automatiques, ou les reprendre (`on` : true suspend, false reprend ; sans lui, bascule)

command-helios-setUp =
    .title = Configurer Helios…

command-helios-app-reimport =
    .title = Ajouter de nouveau à la bibliothèque les photos des dossiers qu’une réinitialisation a gardés, là où elles sont (rien n’est copié ni déplacé)

command-helios-app-reimport-folders =
    .title = Les dossiers de photos qu’une réinitialisation a gardés, proposés pour un nouvel ajout sur place

command-init-apply =
    .title = Écrire les réglages de la configuration (`library.folder` : le dossier de la bibliothèque)

command-init-chooseFolder =
    .title = Choisir le dossier de la bibliothèque pour la configuration

command-init-libraryFolder =
    .title = Choisir le dossier de la bibliothèque dans la configuration (`path` : réglé aussitôt)

command-library-importSession =
    .title = Montrer une importation dans la bibliothèque (`id` : une importation de `import.history.list` ; null : toute la bibliothèque), toutes ses photos sélectionnées avec `select: true` ; elle se combine aux autres filtres, rien n’est copié ni déplacé. Sans `id`, dit l’importation montrée

command-library-show =
    .title = Montrer exactement ces photos dans la bibliothèque (`ids` : des identifiants d’images, par exemple ceux d’une tâche), le filtre vidé et toutes sélectionnées ; le filtre suivant reprend la main. Sans `ids`, dit combien de photos l’ensemble montré contient

command-library-runWorkshop =
    .title = Lancer l’atelier sur la sélection…

command-library-view-close =
    .title = Fermer une vue de la bibliothèque (`view` : son id) ; les autres vues gardent leur filtre et leur curseur

command-library-view-open =
    .title = Ouvrir une autre vue de la bibliothèque (`place` : last, here ou une zone) : son propre filtre et son propre curseur, gardés avec la disposition. Répond son id (`view`). Avec `strip` : true, le bandeau de tri : une rangée sous la comparaison, liée à la vue principale, Espace y ajoutant ou en retirant sa photo

command-library-view-link =
    .title = Lier une vue de la bibliothèque à la vue principale, ou la délier (`view` ; `linked` : true ou false, aucun : l'inverse) : liée, elle suit la sélection de la vue principale

