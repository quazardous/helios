    .title = Passer une macro à une version plus récente de son fichier (`node`, `version` ; `dry_run`)

command-macro-interface =
    .title = Choisir les paramètres qu’une macro montre, enregistrés comme une nouvelle version (`node`, le nœud sélectionné par défaut ; `exposed` ; `dry_run`)

command-helios-workshops-detach =
    .title = Déplacer Ateliers dans une nouvelle fenêtre

command-helios-workshops-dock =
    .title = Remettre Ateliers dans sa zone

command-helios-workshops-float =
    .title = Faire flotter Ateliers au-dessus de l’interface (`pos` : [x, y])

command-helios-workshops-moveTo =
    .title = Déplacer Ateliers vers une zone (`area`)

command-workshop-answer =
    .title = Expérimental : répondre à une valeur proposée : l’accepter ou mettre la vôtre (une étape d’annulation chacune), ou la rejeter ; enregistré dans la session (`of` : l’étape de la proposition ; `param` ; `action` : accept, override ou reject ; `value` pour override) ; à vous seul

command-workshop-apply =
    .title = Expérimental : appliquer un atelier après un nœud, réglé sur l’image ouverte (`workshop` : id@version ; `after` : le nœud d’où l’image est montrée par défaut ; `aim` : vrai par défaut ; `dry_run`)

command-workshop-aim =
    .title = Expérimental : régler à nouveau les cibles d’un atelier appliqué sur l’image ouverte, une étape de valeurs (`node` : le nœud sélectionné par défaut ; `dry_run`)

command-workshop-context =
    .title = Expérimental : ce qu’un agent lit pour concevoir un atelier : les mots, les mesures de l’image, les modules, les briques ; un aperçu seulement si permis (`intent` : celui de la session par défaut ; `proxy` ; `modules`)

command-workshop-describe =
    .title = Expérimental : commencer à concevoir un atelier à partir de vos mots, auxquels répond votre propre agent par MCP (`intent` ; `cancel`)

command-workshop-design =
    .title = Expérimental : vérifier un brouillon d’atelier sur l’image ouverte et l’appliquer en une étape d’annulation (`draft` ; `intent` : celui de la session par défaut ; `apply` : vrai par défaut ; `replace` ; `dry_run`)

command-workshop-generalise =
    .title = Expérimental : rendre automatique l’atelier piloté : une ligne par curseur (une cible qu’une mesure explique, sinon une valeur fixe, ou laissé à l’IA) et par zone d’IA (un masque paramétrique ajusté, ou laissée à l’IA), avec ses preuves, et J, A (l’IA restante, appels par photo) (`rows` : les choix par nom ; `confirm` : écrire la version suivante, à vous seul ; `session` ; `dry_run`)

command-workshop-propose =
    .title = Expérimental : proposer des valeurs pour l’atelier piloté, montrées comme valeurs fantômes que l’utilisateur accepte, remplace ou rejette (`values` : par nom de curseur ; `aim` : les mots auxquels elles répondent ; `session`)

command-workshop-review =
    .title = Expérimental : revoir une passe d’atelier, les photos signalées d’abord, avec leurs signalements, la provenance et les valeurs avant et après ; ou agir sur une photo (`run` : la dernière par défaut ; `flag` : seulement les photos qui le lèvent ; `action` : accept ou revert (à vous seul), fix (`values`), decide une jonction laissée à son repli (`junction`, `value`, inscrite dans le carnet de décisions), rerun les photos retenues et décidées (à vous seul) ; `image`)

command-workshop-run =
    .title = Expérimental : lancer l’atelier appliqué sur un ensemble de photos, une tâche : chaque photo visée, ses jonctions répondues, vérifiée contre les limites, écrite ou retenue ; une étape d’annulation (`node` : le nœud sélectionné par défaut ; `set` : selection ou view ; `images` : des identifiants à la place ; `on_breach` : flag, hold ou stop ; `dry_run` : les photos, J, A et ce que le carnet de décisions répond déjà)

command-workshop-save =
    .title = Expérimental : enregistrer une macro comme atelier, sa version suivante avec une intention, des mots-clés et des cibles (`node` : le nœud sélectionné par défaut ; `intent`, `keywords`, `targets` ; `dry_run`) ; sans `intent`, un formulaire les demande

command-workshop-send-proxy =
    .title = Expérimental : laisser un agent voir un petit aperçu de l’image ouverte, pour cette session (`on`) ; seul l’utilisateur peut l’activer

command-workshop-session =
    .title = Expérimental : l’enregistrement de la session d’atelier : chaque étape du pilotage, son auteur, son but et les mesures des zones (`action` : read, keep (le vôtre seulement : une session non gardée est abandonnée à sa fin) ou close)

command-workshop-suggest =
    .title = Expérimental : trouver des ateliers d’après ce que vous voulez, classés par nom, mots-clés puis intention (`intent`)

command-help-health =
    .title = Bilan de santé…

command-import-addSource =
    .title = Ajouter une source à connecter : ouvre la fenêtre d’import et lance les étapes de connexion du connecteur (`connector`)

command-import-disconnect =
    .title = Déconnecter un compte d’import (`account`) : son jeton révoqué quand le service le permet, ses secrets oubliés ; les sources enregistrées qui l’utilisent sont gardées sans connexion (`sources` : "keep") ou oubliées avec lui ("forget") ; un compte qu’aucune source n’utilise est oublié

command-import-history-again =
    .title = Importer à nouveau (`id` : une importation de `import.history.list`) : les mêmes sources avec les mêmes choix ; les photos déjà dans la bibliothèque sont ignorées comme doublons

command-import-history-list =
