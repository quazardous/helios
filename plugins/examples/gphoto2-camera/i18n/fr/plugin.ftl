# The plugin's own text: its keys carry its id.

plugin-io-github-quazardous-helios-gphoto2-camera =
    .title = Appareils gphoto2
    .description = Liste, pilote et télécharge les appareils que gphoto2 connaît

# Its capture controls (ui/controls.json).
io-github-quazardous-helios-gphoto2-camera-capture = Prise de vue
io-github-quazardous-helios-gphoto2-camera-iso = ISO
io-github-quazardous-helios-gphoto2-camera-iso-about = La sensibilité de l’appareil ; auto laisse l’appareil choisir
io-github-quazardous-helios-gphoto2-camera-shutter = Vitesse d’obturation
io-github-quazardous-helios-gphoto2-camera-shutter-about = Combien de temps l’obturateur reste ouvert, en secondes
# Its focus point on the image (ui/controls.json, its tool).
io-github-quazardous-helios-gphoto2-camera-focus = Point de mise au point
io-github-quazardous-helios-gphoto2-camera-focus-show = Point de mise au point sur l’image
io-github-quazardous-helios-gphoto2-camera-focus-show-about = Montre une poignée sur la photo ; la glisser déplace le zoom de la visée de l’appareil vers ce point
io-github-quazardous-helios-gphoto2-camera-focus-x = Point de mise au point, en largeur
io-github-quazardous-helios-gphoto2-camera-focus-y = Point de mise au point, en hauteur
