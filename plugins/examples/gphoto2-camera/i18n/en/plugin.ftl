# The plugin's own text: its keys carry its id.

plugin-io-github-quazardous-helios-gphoto2-camera =
    .title = gphoto2 cameras
    .description = Lists, drives and downloads from the cameras gphoto2 knows

# Its capture controls (ui/controls.json).
io-github-quazardous-helios-gphoto2-camera-capture = Capture
io-github-quazardous-helios-gphoto2-camera-iso = ISO
io-github-quazardous-helios-gphoto2-camera-iso-about = The camera's sensitivity; auto lets the camera choose
io-github-quazardous-helios-gphoto2-camera-shutter = Shutter speed
io-github-quazardous-helios-gphoto2-camera-shutter-about = How long the shutter stays open, in seconds
# Its focus point on the image (ui/controls.json, its tool).
io-github-quazardous-helios-gphoto2-camera-focus = Focus point
io-github-quazardous-helios-gphoto2-camera-focus-show = Focus point on the image
io-github-quazardous-helios-gphoto2-camera-focus-show-about = Shows a handle over the photo; dragging it moves the camera's live-view zoom to that point
io-github-quazardous-helios-gphoto2-camera-focus-x = Focus point, across
io-github-quazardous-helios-gphoto2-camera-focus-y = Focus point, down
