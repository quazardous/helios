{
  "version": 1,
  "title": "io-github-quazardous-helios-gphoto2-camera-capture",
  "values": {
    "iso": {
      "type": "choice",
      "label": "io-github-quazardous-helios-gphoto2-camera-iso",
      "description": "io-github-quazardous-helios-gphoto2-camera-iso-about",
      "choices": ["auto", "100", "200", "400", "800", "1600", "3200", "6400"],
      "default": "auto"
    },
    "shutter": {
      "type": "float",
      "label": "io-github-quazardous-helios-gphoto2-camera-shutter",
      "description": "io-github-quazardous-helios-gphoto2-camera-shutter-about",
      "min": 0.000125,
      "max": 30,
      "default": 0.008,
      "step": 0.0001,
      "precision": 4,
      "unit": "s",
      "logarithmic": true
    },
    "focus-show": {
      "type": "bool",
      "label": "io-github-quazardous-helios-gphoto2-camera-focus-show",
      "description": "io-github-quazardous-helios-gphoto2-camera-focus-show-about",
      "default": false
    },
    "focus-x": {
      "type": "float",
      "label": "io-github-quazardous-helios-gphoto2-camera-focus-x",
      "min": 0,
      "max": 100000,
      "default": 500,
      "precision": 0,
      "unit": "px"
    },
    "focus-y": {
      "type": "float",
      "label": "io-github-quazardous-helios-gphoto2-camera-focus-y",
      "min": 0,
      "max": 100000,
      "default": 500,
      "precision": 0,
      "unit": "px"
    }
  },
  "case": {
    "items": [
      {
        "part": {
          "name": "iso",
          "control": "implicit"
        }
      },
      {
        "part": {
          "name": "shutter",
          "control": "implicit"
        }
      },
      {
        "part": {
          "name": "focus-show",
          "control": "implicit"
        }
      }
    ]
  },
  "tools": [
    {
      "name": "focus",
      "label": "io-github-quazardous-helios-gphoto2-camera-focus",
      "when": "focus-show",
      "handles": {
        "format": "egui_hud-handles/1",
        "handles": [
          {
            "name": "focus",
            "kind": "point",
            "centre": { "x": "focus-x", "y": "focus-y" },
            "look": "move"
          }
        ]
      }
    }
  ]
}
