<component type="desktop-application">
  <id>io.github.quazardous.Helios</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Helios</name>
  <summary>Edit raw photos with darktable's processing</summary>
  <developer id="io.github.quazardous">
    <name>quazardous</name>
  </developer>
  <description>
    <p>
      Helios is an image processing framework whose first application is
      photo editing: the quality of darktable's processing without having
      to learn darktable.
    </p>
    <p>
      It keeps photos in a library (the vault), processes them through a
      graph of modules on the GPU when there is one and on the CPU
      otherwise, and exports them. It can import a darktable library.
    </p>
    <p>
      Helios is in an early stage of development: expect missing features
      and changes from one release to the next.
    </p>
  </description>
  <launchable type="desktop-id">io.github.quazardous.Helios.desktop</launchable>
